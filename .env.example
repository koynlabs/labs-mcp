# Where this is served. Used to build the sign and approval links handed back
# through MCP, so in production it has to be the public URL, not localhost.
LABS_SITE_URL=https://labs.koyn.trade

# Optional. Public X account in the site footer and twitter card metadata.
# A handle, @handle, or x.com / twitter.com profile URL. Blank hides the link.
# Display only — this is not the OAuth app used for posting.
NEXT_PUBLIC_TWITTER=

# Optional. Swap, trigger, and perps work without it. A key raises Jupiter's rate limit.
JUPITER_API_KEY=
# Ultra referral account from https://referral.jup.ag. Market swaps on /order pay it.
# Jupiter allows 50–255 bps and keeps 20%. Default 50 (0.5%).
JUPITER_ULTRA_REFERRAL_ACCOUNT=
JUPITER_REFERRAL_FEE_BPS=50

# Solana RPC. The public endpoint rate-limits hard; use a paid one.
SOLANA_RPC=https://api.mainnet-beta.solana.com

# Pins launch metadata to IPFS. Without it, labs serves the metadata JSON from
# its own /api/metadata route, which only lasts as long as this deployment —
# and the URI is written into the token on chain. Set it in production.
LABS_PINATA_JWT=
LABS_IPFS_GATEWAY=https://ipfs.io/ipfs

# Read-only pump.fun data (bonding curve, token details). Public, no key.
PUMP_READ_MCP_URL=https://three.ws/api/pump-fun-mcp

# 32+ random bytes. Encrypts maker session keys, Jupiter trigger sessions,
# and the mint keypair a launch generates. Required before a launch can be
# built: the mint key is sealed until the creator's wallet has signed, then
# used only to co-sign the create. It holds no funds and is not a wallet key.
# Rotating it invalidates every live session and every unsigned launch.
# Set this in the Vercel project env before deploying.
LABS_SESSION_SECRET=

# Optional. Lookup table for pump.fun create+buy transactions. Defaults to the
# table current pump.fun creates use. Set this only if that table is deactivated.
LABS_PUMP_LUT=

# Two-sided quoting is off unless this is exactly "true".
LABS_MAKER_ENABLED=false

# Redis. Launch bundles fall back to memory in dev, but maker sessions refuse
# to start without this, because a workflow step resumes in a new invocation.
# Vercel Redis sets REDIS_URL. Upstash REST is the alternative.
# X tokens use the same store. Set Redis in production or the connection
# disappears on the next cold start.
REDIS_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=

# X (Twitter) posting. OAuth 2.0 user context, confidential client, PKCE.
# Anyone opens /x (or /api/x/oauth/start) and authorizes their own account.
# That visit issues a personal key, shown once. The MCP client sends it as:
#   Authorization: Bearer <personal key>
# on POST https://labs.koyn.trade/mcp. There is no shared LABS_X_API_KEY.
# A missing or unknown key does no X work. Do not log personal keys.
# Reuse the KOYN FX X app: add this exact callback to its allowed callbacks:
#   https://labs.koyn.trade/api/x/oauth/callback
# Scopes on that app: tweet.read tweet.write users.read offline.access media.write like.write
# like.write is required for x_like_post and x_unlike_post. Accounts connected
# before it was requested keep posting, and must reconnect to like.
# Tokens are AES-GCM sealed. Refresh tokens rotate and the new one is stored.
# Never commit these values.
X_CLIENT_ID=
X_CLIENT_SECRET=
# Optional. Defaults to X_CLIENT_SECRET. Set it so rotating the client secret
# does not make the stored tokens unreadable. 16+ characters.
X_TOKEN_ENCRYPTION_KEY=
# API Key and API Key Secret. Together they sign the homepage Crypto Twitter
# strip. The secret also signs the Account Activity CRC and webhook body.
# This secret is not X_CLIENT_SECRET.
X_CONSUMER_KEY=
X_CONSUMER_SECRET=
# Replies per UTC day. 0 refuses that class of reply.
X_REPLY_AUTHOR_DAILY_CAP=5
X_REPLY_DAILY_CAP=30
# Likes and unlikes per account per UTC day. 0 refuses both.
X_LIKE_DAILY_CAP=30
